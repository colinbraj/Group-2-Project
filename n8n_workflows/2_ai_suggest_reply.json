            "name": "Has New Comments?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                -304,
                -80
            ]
        },
        {
            "parameters": {
                "jsCode": "// Store comment IDs for later use and prepare prompts\nconst comments = $input.all();\nconst results = [];\n\nfor (const comment of comments) {\n  results.push({\n    json: {\n      id: comment.json.id,\n      platform: comment.json.platform,\n      author: comment.json.author,\n      message: comment.json.message,\n      prompt: `Platform: ${comment.json.platform}\\nComment from ${comment.json.author}:\\n\"${comment.json.message}\"\\n\\nGenerate a suggested reply:`\n    }\n  });\n}\n\nreturn results;"
            },
            "id": "68b967de-e533-45be-8ea5-85d08df5437b",
            "name": "Prepare Prompts",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -80,
                -128
            ]
        },
        {
            "parameters": {
                "modelId": {
                    "__rl": true,
                    "value": "gpt-4o-mini",
                    "mode": "list",
                    "cachedResultName": "GPT-4O-MINI"
                },
                "messages": {
                    "values": [
                        {
                            "content": "You are a friendly and professional community manager. Generate a helpful reply suggestion for social media comments. Keep responses concise (under 280 characters), engaging, and on-brand. Never be defensive or argumentative. Include appropriate emojis when suitable.",
                            "role": "system"
                        },
                        {
                            "content": "=Platform: {{ $json.platform }}\\nComment from {{ $json.author }}:\\n\\\"{{ $json.message }}\\\"\\n\\nGenerate a suggested reply:"
                        }
                    ]
                },
                "options": {
                    "maxTokens": 150,
                    "temperature": 0.7
                }
            },
            "id": "47df33e8-255d-49f5-b8f8-ce2aefbd7257",
            "name": "AI Generate Reply",
            "type": "@n8n/n8n-nodes-langchain.openAi",
            "typeVersion": 1.3,
            "position": [
                96,
                -128
            ],
            "credentials": {
                "openAiApi": {
                    "id": "GUW3QHFF650Z7C41",
                    "name": "OpenAi account 2"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Process AI responses and prepare for Supabase update\nconst aiResponses = $input.all();\nconst preparedData = $('Prepare Prompts').all();\nconst results = [];\n\nfor (let i = 0; i < aiResponses.length; i++) {\n  const aiItem = aiResponses[i];\n  const originalData = preparedData[i];\n  \n  // Extract the reply text from OpenAI response\n  const reply = aiItem.json.message?.content || aiItem.json.text || aiItem.json.output || '';\n  \n  // Calculate confidence based on response quality\n  const confidence = Math.min(0.95, 0.7 + (reply.length > 50 ? 0.1 : 0) + (reply.includes('?') ? 0.05 : 0) + Math.random() * 0.1);\n  \n  results.push({\n    json: {\n      id: originalData.json.id,\n      ai_suggested_reply: reply.trim(),\n      ai_confidence: parseFloat(confidence.toFixed(2)),\n      reply_status: 'suggested'\n    }\n  });\n}\n\nreturn results;"
            },
            "id": "ae650b74-f47f-4951-bfba-4275157aadca",
            "name": "Prepare Update",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
