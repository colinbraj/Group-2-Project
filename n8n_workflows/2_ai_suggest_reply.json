                            "value": "return=representation"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"ai_suggested_reply\": \"{{ $json.ai_suggested_reply }}\", \"ai_confidence\": {{ $json.ai_confidence }}, \"reply_status\": \"{{ $json.reply_status }}\"}",
                "options": {}
            },
