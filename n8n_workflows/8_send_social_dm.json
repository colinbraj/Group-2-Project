            "parameters": {
                "jsCode": "// Check if the API call was successful or failed\nconst input = $input.first().json;\n\n// Check for error response from Instagram API\nif (input.error) {\n  const errorCode = input.error.error_subcode || input.error.code;\n  const errorMessage = input.error.message || 'Unknown error';\n  \n  // Handle 24-hour messaging window expiration\n  if (errorCode === 2534022 || errorMessage.includes('outside of allowed window')) {\n    return [{\n      json: {\n        success: false,\n        error: 'messaging_window_expired',\n        message: 'Cannot send message: The 24-hour messaging window has expired. The user must message you first before you can reply.',\n        details: errorMessage\n      }\n    }];\n  }\n  \n  // Handle other errors\n  return [{\n    json: {\n      success: false,\n      error: 'api_error',\n      message: errorMessage,\n      code: errorCode\n    }\n  }];\n}\n\n// Success case\nreturn [{\n  json: {\n    success: true,\n    message_id: input.message_id || 'sent'\n  }\n}];"
            },
