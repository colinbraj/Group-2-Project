            "position": [
                0,
                208
            ]
        },
        {
            "parameters": {
                "jsCode": "// Normalize Facebook comments\nconst fbPosts = $('Get FB Posts').first().json.data || [];\nconst fbComments = [];\n\nfor (const post of fbPosts) {\n  if (post.comments && post.comments.data) {\n    for (const comment of post.comments.data) {\n      fbComments.push({\n        platform: 'facebook',\n        post_id: post.id,\n        comment_id: comment.id,\n        author: comment.from?.name || 'Unknown',\n        message: comment.message,\n        created_at: comment.created_time,\n        reply_status: 'new'\n      });\n    }\n  }\n}\n\nreturn fbComments.map(c => ({ json: c }));"
            },
            "id": "c8de8f23-b233-42ac-8074-438746a31d6b",
            "name": "Normalize FB Comments",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                224,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// Normalize Instagram comments (when comments are included in Get IG Media)\nconst igMedia = $('Get IG Media').first().json.data || [];\nconst igComments = [];\n\nfor (const media of igMedia) {\n  const comments = media.comments?.data || [];\n  for (const comment of comments) {\n    // Try multiple sources for username: from.username, direct username, or 'Unknown'\n    const username = comment.from?.username || comment.username || 'Unknown';\n    igComments.push({\n      platform: 'instagram',\n      post_id: media.id,\n      comment_id: comment.id,\n      author: username,\n      message: comment.text || '',\n      created_at: comment.timestamp || '',\n      reply_status: 'new'\n    });\n  }\n}\n\nreturn igComments.map(c => ({ json: c }));"
            },
