# ============================================================================
# KadoshAI Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values

# OpenAI API Key (required for AI features)
VITE_OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# n8n Configuration (for workflow automation)
VITE_N8N_BASE_URL=http://localhost:5678
VITE_N8N_CREATE_POST_WEBHOOK=/webhook/create-post

# Instagram DM Integration (n8n webhooks)
VITE_N8N_FETCH_DMS_WEBHOOK=/webhook/fetch-dms
VITE_N8N_SEND_DM_WEBHOOK=/webhook/send-dm

# Instagram Graph API Access Token (configured in n8n workflows)
# Get this from Facebook Developer Console > Instagram Graph API
# IG_ACCESS_TOKEN=your-instagram-access-token
